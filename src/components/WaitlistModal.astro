<div class="waitlist-overlay" id="waitlist-overlay">
  <div class="waitlist-box">
    <button class="waitlist-close" id="waitlist-close" aria-label="Close">&times;</button>
    <h3>join the waitlist</h3>
    <form id="waitlist-form">
      <div>
        <label for="wl-name">Name</label>
        <input type="text" id="wl-name" name="name" required>
      </div>
      <div>
        <label for="wl-email">Email</label>
        <input type="email" id="wl-email" name="email" required>
      </div>
      <div>
        <label for="wl-message">Message</label>
        <textarea id="wl-message" name="message" placeholder="Anything you'd like us to know?"></textarea>
      </div>
      <button type="submit" class="cta waitlist-submit" id="waitlist-submit-btn">Join the Waitlist</button>
      <p id="waitlist-status" class="waitlist-status"></p>
    </form>
  </div>
</div>

<script>
  function initWaitlistModal() {
    const waitlistOverlay = document.getElementById('waitlist-overlay');
    const waitlistClose = document.getElementById('waitlist-close');
    const waitlistForm = document.getElementById('waitlist-form') as HTMLFormElement;
    const waitlistSubmitBtn = document.getElementById('waitlist-submit-btn') as HTMLButtonElement;
    const waitlistStatus = document.getElementById('waitlist-status');
    if (!waitlistOverlay || !waitlistClose || !waitlistForm || !waitlistSubmitBtn || !waitlistStatus) return;

    function openWaitlist() {
      waitlistOverlay!.classList.add('open');
    }
    function closeWaitlist() {
      waitlistOverlay!.classList.remove('open');
    }

    document.querySelectorAll('.waitlist-trigger').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openWaitlist();
      });
    });
    waitlistClose.addEventListener('click', closeWaitlist);
    waitlistOverlay.addEventListener('click', (e) => {
      if (e.target === waitlistOverlay) closeWaitlist();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeWaitlist();
    });

    waitlistForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      waitlistSubmitBtn.disabled = true;
      waitlistSubmitBtn.textContent = 'Sending...';
      waitlistStatus.className = 'waitlist-status';
      waitlistStatus.textContent = '';

      const data = {
        name: (waitlistForm.elements.namedItem('name') as HTMLInputElement).value,
        email: (waitlistForm.elements.namedItem('email') as HTMLInputElement).value,
        message: (waitlistForm.elements.namedItem('message') as HTMLTextAreaElement).value,
      };

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (res.ok) {
          waitlistStatus.textContent = 'Thank you.';
          waitlistStatus.className = 'waitlist-status success';
          waitlistForm.reset();
        } else {
          waitlistStatus.textContent = result.error || 'Something went wrong. Please try again.';
          waitlistStatus.className = 'waitlist-status error';
        }
      } catch (err) {
        waitlistStatus.textContent = 'Something went wrong. Please try again.';
        waitlistStatus.className = 'waitlist-status error';
      } finally {
        waitlistSubmitBtn.disabled = false;
        waitlistSubmitBtn.textContent = 'Join the Waitlist';
      }
    });
  }

  document.addEventListener('astro:page-load', initWaitlistModal);
</script>
