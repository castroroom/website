---
import { images, imagePath, teaserImages } from '../../data/images';
---

<section id="teacher-training">
  <h1 style="margin-bottom:0.25rem;"><a class="section-link section-link--cream" href="/teacher-training"><span style="font-size:0.85em; font-weight:400;">200</span>-Hour Teacher Training</a></h1>
  <h2 style="font-size:1.1rem; margin-top:0.25rem; margin-bottom:1.5rem;">led by jason bowman</h2>
  <p style="font-style:italic;">"A fabulous combination of the cerebral and the embodied."<br>
  "The format is so supportive, and the attention to detail was incredible."<br>
  "I feel like this has changed who I am as a person, and how I interact with the world."</p>
  <h2 style="font-size:1.1rem; margin-top:0.25rem; margin-bottom:0.25rem;">the distinguished training to take your practice further</h2>
  <a class="cta teacher-training-cta" href="/teacher-training">Learn More</a>
  <div class="photo-grid" style="grid-template-columns: repeat(3, 1fr);">
    {teaserImages.map((key) => (
      <img src={imagePath(key)} alt={images[key].alt} width={images[key].width} height={images[key].height} loading="lazy" decoding="async" style="height:315px; object-fit:cover;" />
    ))}
  </div>
</section>
