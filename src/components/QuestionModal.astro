<div class="waitlist-overlay" id="question-overlay">
  <div class="waitlist-box">
    <button class="waitlist-close" id="question-close" aria-label="Close">&times;</button>
    <h3>ask a question</h3>
    <form id="question-form">
      <div>
        <label for="q-name">Name</label>
        <input type="text" id="q-name" name="name" required>
      </div>
      <div>
        <label for="q-email">Email</label>
        <input type="email" id="q-email" name="email" required>
      </div>
      <div>
        <label for="q-message">Message</label>
        <textarea id="q-message" name="message" required></textarea>
      </div>
      <button type="submit" class="cta waitlist-submit" id="question-submit-btn">Send Question</button>
      <p id="question-status" class="waitlist-status"></p>
    </form>
  </div>
</div>

<script>
  function initQuestionModal() {
    const questionOverlay = document.getElementById('question-overlay');
    const questionClose = document.getElementById('question-close');
    const questionForm = document.getElementById('question-form') as HTMLFormElement;
    const questionSubmitBtn = document.getElementById('question-submit-btn') as HTMLButtonElement;
    const questionStatus = document.getElementById('question-status');
    if (!questionOverlay || !questionClose || !questionForm || !questionSubmitBtn || !questionStatus) return;

    function openQuestion() {
      questionOverlay!.classList.add('open');
    }
    function closeQuestion() {
      questionOverlay!.classList.remove('open');
    }

    document.querySelectorAll('.question-trigger').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openQuestion();
      });
    });
    questionClose.addEventListener('click', closeQuestion);
    questionOverlay.addEventListener('click', (e) => {
      if (e.target === questionOverlay) closeQuestion();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeQuestion();
    });

    questionForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      questionSubmitBtn.disabled = true;
      questionSubmitBtn.textContent = 'Sending...';
      questionStatus.className = 'waitlist-status';
      questionStatus.textContent = '';

      const data = {
        name: (questionForm.elements.namedItem('name') as HTMLInputElement).value,
        email: (questionForm.elements.namedItem('email') as HTMLInputElement).value,
        subject: 'Teacher Training Question',
        message: (questionForm.elements.namedItem('message') as HTMLTextAreaElement).value,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (res.ok) {
          questionStatus.textContent = 'Thank you.';
          questionStatus.className = 'waitlist-status success';
          questionForm.reset();
        } else {
          questionStatus.textContent = result.error || 'Something went wrong. Please try again.';
          questionStatus.className = 'waitlist-status error';
        }
      } catch (err) {
        questionStatus.textContent = 'Something went wrong. Please try again.';
        questionStatus.className = 'waitlist-status error';
      } finally {
        questionSubmitBtn.disabled = false;
        questionSubmitBtn.textContent = 'Send Question';
      }
    });
  }

  document.addEventListener('astro:page-load', initQuestionModal);
</script>
