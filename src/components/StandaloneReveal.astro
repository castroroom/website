<script>
  // Standalone pages are a single section already on screen at load, so there
  // is no scroll to wait for. Add `visible` shortly after first paint so the
  // same fade-in used on the home page plays, instead of text staying at
  // opacity: 0 forever (which is what happened without this).
  function revealStandalone() {
    setTimeout(() => {
      document.querySelectorAll('section').forEach((s) => s.classList.add('visible'));
    }, 60);
  }
  revealStandalone();
</script>
