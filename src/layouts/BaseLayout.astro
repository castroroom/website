---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
import { SITE, images, imageUrl, pageImages, type ImageKey } from '../data/images';
// Note: no global stylesheet imported here on purpose. Each page imports
// its own complete, self-contained stylesheet (global.css for the home-style
// pages, teacher-training.css, contact.css) to avoid two independently
// authored stylesheets colliding on shared selector names. CSS cascade is
// per-property, not per-file, so a property declared only in one file
// silently survives even when the "other" file is meant to own that selector.

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/" or "/about"
  ogImageKey?: ImageKey; // which photo represents this page when shared / in image results
  activeNav?: string; // which nav link, if any, should be marked active
  standalone?: boolean; // true for single-section pages (/about, /schedule, ...) that need to clear the fixed nav
}

const {
  title,
  description,
  path,
  ogImageKey = 'hero',
  activeNav,
  standalone = false,
} = Astro.props;

const canonical = `${SITE}${path}`;
const og = images[ogImageKey];
const ogUrl = imageUrl(ogImageKey);

const toImageObject = (key: ImageKey) => {
  const i = images[key];
  return {
    '@type': 'ImageObject',
    contentUrl: imageUrl(key),
    url: imageUrl(key),
    name: i.title,
    description: i.description,
    caption: i.alt,
    width: i.width,
    height: i.height,
  };
};

const pageKeys = pageImages[path] ?? [];
const primaryKey: ImageKey = pageKeys.includes(ogImageKey) ? ogImageKey : (pageKeys[0] ?? ogImageKey);

const businessLd = {
  '@context': 'https://schema.org',
  '@type': 'ExerciseGym',
  name: 'The Castro Room',
  image: [imageUrl('hero')],
  url: SITE,
  telephone: '+14155291261',
  email: 'hello@castroroom.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '97 Collingwood Street',
    addressLocality: 'San Francisco',
    addressRegion: 'CA',
    postalCode: '94114',
    addressCountry: 'US',
  },
  sameAs: ['https://instagram.com/castro.room'],
};

const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: 'en-US',
  isPartOf: { '@type': 'WebSite', name: 'The Castro Room', url: SITE },
  primaryImageOfPage: toImageObject(primaryKey),
  ...(pageKeys.length ? { image: pageKeys.map(toImageObject) } : {}),
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7CMZ8CLH2G"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-7CMZ8CLH2G');
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <link rel="canonical" href={canonical}>

  <meta property="og:site_name" content="The Castro Room">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogUrl}>
  <meta property="og:image:width" content={String(og.width)}>
  <meta property="og:image:height" content={String(og.height)}>
  <meta property="og:image:alt" content={og.alt}>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogUrl}>
  <meta name="twitter:image:alt" content={og.alt}>

  <script type="application/ld+json" set:html={JSON.stringify(businessLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(pageLd)} />

  <link rel="stylesheet" href="https://use.typekit.net/acb2tog.css">
</head>
<body>
  <Nav active={activeNav} />
  <main class:list={{ standalone }}>
    <slot />
  </main>
  <Footer />
  <slot name="modals" />
  <Lightbox />
  <slot name="scripts" />
</body>
</html>
