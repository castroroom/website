---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Schedule from '../components/sections/Schedule.astro';
import StandaloneReveal from '../components/StandaloneReveal.astro';
---

<BaseLayout
  title="schedule | the castro room"
  description="View and book vinyasa yoga classes at The Castro Room in San Francisco. Browse the full class schedule and register directly."
  path="/schedule"
  standalone
>
  <Schedule linked={false} />

  <Fragment slot="scripts">
    <StandaloneReveal />
  </Fragment>
</BaseLayout>
