---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import Events from '../components/sections/Events.astro';
import StandaloneReveal from '../components/StandaloneReveal.astro';
---

<BaseLayout
  title="events | the castro room"
  description="Workshops, community gatherings, and special events at The Castro Room, a yoga studio in San Francisco's Castro neighborhood."
  path="/events"
  standalone
>
  <Events height={1300} />

  <Fragment slot="scripts">
    <StandaloneReveal />
  </Fragment>
</BaseLayout>
