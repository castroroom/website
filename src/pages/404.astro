---
// Catches every old event landing page slug and any other dead link,
// sending visitors straight to the homepage instead of a dead end.
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>the castro room</title>
  <meta http-equiv="refresh" content="0; url=/">
  <link rel="canonical" href="https://castroroom.com/">
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #FAF9F2;
      color: #5e2f00;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      text-align: center;
    }
    a { color: #5e2500; }
  </style>
  <script is:inline>window.location.replace('/');</script>
</head>
<body>
  <p>Redirecting to <a href="/">The Castro Room</a>&hellip;</p>
</body>
</html>
